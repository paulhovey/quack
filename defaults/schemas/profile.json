{
  "$defs": {
    "Defaults": {
      "additionalProperties": false,
      "description": "Defaults that a provider's model entry can override.",
      "properties": {
        "edit_format": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The edit tool this family was trained with; `[tools] edit_format` overrides it."
        },
        "reasoning_format": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sampling": {
          "$ref": "#/$defs/Sampling",
          "default": {
            "min_p": null,
            "repetition_penalty": null,
            "temperature": null,
            "top_k": null,
            "top_p": null
          }
        }
      },
      "type": "object"
    },
    "EditFormat": {
      "oneOf": [
        {
          "const": "auto",
          "description": "The profile's choice, else `str_replace`.",
          "type": "string"
        },
        {
          "const": "str_replace",
          "description": "`edit`: replace a unique snippet.",
          "type": "string"
        },
        {
          "const": "hashline",
          "description": "Hash-anchored edits: `read` tags each line, and edits name lines by tag.",
          "type": "string"
        },
        {
          "const": "apply_patch",
          "description": "`apply_patch`: the Codex patch format, several files per call.",
          "type": "string"
        },
        {
          "const": "whole_file",
          "description": "No edit tool: files are rewritten whole with `write`.",
          "type": "string"
        },
        {
          "const": "search_replace_blocks",
          "description": "`edit_blocks`: SEARCH/REPLACE blocks under each file's path.",
          "type": "string"
        }
      ]
    },
    "Match": {
      "additionalProperties": false,
      "description": "Used when a model's `profile = \"auto\"`.",
      "properties": {
        "model": {
          "default": [],
          "description": "Globs over the model id or alias, e.g. `*qwen3-coder*`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "priority": {
          "default": 0,
          "description": "Highest matching priority wins.",
          "format": "int32",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ParamMapping": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "default": null,
          "description": "Sent when the model leaves the parameter out."
        },
        "to": {
          "description": "Internal parameter name.",
          "type": "string"
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transform"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "to"
      ],
      "type": "object"
    },
    "Prompt": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "default": "system.md",
          "description": "minijinja template, relative to the profile directory.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ReasoningFormat": {
      "oneOf": [
        {
          "enum": [
            "none",
            "reasoning_content",
            "reasoning",
            "think-tags"
          ],
          "type": "string"
        },
        {
          "const": "auto",
          "description": "Read `reasoning_content` / `reasoning` fields, and split `<think>` tags when the reply opens with one.",
          "type": "string"
        }
      ]
    },
    "Sampling": {
      "additionalProperties": false,
      "properties": {
        "min_p": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "repetition_penalty": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "temperature": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "top_k": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "top_p": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ToolMapping": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": null,
          "description": "Description shown to the model, or a `.md` file in the profile directory holding\nit; default: the internal tool's own.",
          "type": [
            "string",
            "null"
          ]
        },
        "fixed": {
          "additionalProperties": true,
          "default": {},
          "description": "Internal parameters always sent with this value and hidden from the model.",
          "type": "object"
        },
        "maps_to": {
          "default": null,
          "description": "Internal tool, e.g. `read`, `edit`, `shell`. Defaults to `name`.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Name the model sees.",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/ParamMapping"
          },
          "default": {},
          "description": "Model-facing parameter name → mapping onto the internal parameter.",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Transform": {
      "description": "The closed set of parameter transforms.",
      "oneOf": [
        {
          "const": "abs_to_workspace",
          "description": "Paths are accepted absolute or relative already; kept for profile compatibility.",
          "type": "string"
        },
        {
          "const": "zero_to_one_based",
          "description": "The model counts lines from 0; internal tools count from 1.",
          "type": "string"
        },
        {
          "const": "one_to_zero_based",
          "description": "The model counts from 1 where the internal tool counts from 0.",
          "type": "string"
        },
        {
          "const": "join_lines",
          "description": "The model sends an array of lines; the internal tool takes one string.",
          "type": "string"
        },
        {
          "const": "argv",
          "description": "The model sends a command as an argument list (`[\"bash\", \"-lc\", \"make\"]`); the\ninternal tool takes one command line.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "defaults": {
      "$ref": "#/$defs/Defaults",
      "default": {
        "edit_format": null,
        "reasoning_format": null,
        "sampling": {
          "min_p": null,
          "repetition_penalty": null,
          "temperature": null,
          "top_k": null,
          "top_p": null
        }
      }
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "exclusive": {
      "default": false,
      "description": "Offer only the tools listed in `[[tools]]` (MCP tools are still added).",
      "type": "boolean"
    },
    "id": {
      "default": null,
      "description": "Defaults to the directory name.",
      "type": [
        "string",
        "null"
      ]
    },
    "match": {
      "$ref": "#/$defs/Match",
      "default": {
        "model": [],
        "priority": 0
      }
    },
    "prompt": {
      "$ref": "#/$defs/Prompt",
      "default": {
        "system": "system.md"
      }
    },
    "source": {
      "description": "Where the prompt and tool descriptions come from. Required for shipped defaults.",
      "type": "string"
    },
    "tools": {
      "default": [],
      "description": "Model-facing tool surface: renames, descriptions and parameter mappings. Internal\ntools not listed keep their internal names.",
      "items": {
        "$ref": "#/$defs/ToolMapping"
      },
      "type": "array"
    }
  },
  "required": [
    "source"
  ],
  "title": "ProfileFile",
  "type": "object"
}
